# Local config for ./printcad.sh. This file is gitignored.
# Paste your OpenRouter key, then run: ./printcad.sh "FDM L-bracket 80x60 mm, 5 mm thick, two M4 holes per leg"
#
# models are tried in order. A rate limit, timeout, or no tool call falls through to the next.
# Catalog check 2026-10-07: upper-end OpenRouter free endpoints that advertise tool calling.
# Ultra / Super are the large Nemotron reasoning models; North Mini Code and Laguna S are coding agents;
# Gemma 4 31B is the dense function-calling fallback; openrouter/free picks any free tool-capable model.

openrouter_api_key = "PASTE_OPENROUTER_API_KEY"

models = [
  "nvidia/nemotron-3-ultra-550b-a55b:free",
  "nvidia/nemotron-3-super-120b-a12b:free",
  "cohere/north-mini-code:free",
  "poolside/laguna-s-2.1:free",
  "google/gemma-4-31b-it:free",
  "openrouter/free",
]

session = "session"
assume_defaults = true
max_iters = 14
